<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Do NOT turn this on. Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" on every connection
         attempt, so the entire reporting surface fails at runtime while the
         build and the test suite stay green. GlobalizationTests guards it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
