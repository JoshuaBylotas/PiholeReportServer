<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>pihole-report-server</UserSecretsId>
    <RootNamespace>PiholeReportServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entra ID (Microsoft identity platform) sign-in + token acquisition -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />

    <!-- SQL Server access. Microsoft.Data.SqlClient supports both a classic
         SQL login and an Entra ID access token on the same connection. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />

    <!-- CSV export -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pre-canned report definitions are shipped as content so they can be
         edited on a deployed server without a rebuild. -->
    <Content Include="Reports\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- .json is already implicit Content under the Web SDK, so Update it rather
         than Include it, or the item is declared twice (NETSDK1022). -->
    <Content Update="Reports\reports.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- SqlGuard.Scrub is internal: it is an implementation detail, but its
         behaviour is worth asserting directly since the keyword screening
         depends on it. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PiholeReportServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
