@page
@model PiholeReportServer.Pages.Query.SqlModel
@{
    ViewData["Title"] = "SQL console";
}

<div class="page-head">
    <span class="eyebrow">Restricted</span>
    <h1>SQL console</h1>
    <p class="lede">
        Free-text <code>SELECT</code> against the warehouse. Reads only: the application
        connects with a login that holds nothing but <code>db_datareader</code>, results
        are capped at @Model.MaxRows.ToString("N0") rows, and statements are screened
        before they run.
    </p>
</div>

@if (!Model.Enabled)
{
    <div class="notice notice-warn">
        <strong>The SQL console is switched off.</strong>
        Set <code>Reporting:EnableRawSql</code> to <code>true</code> to enable it.
    </div>
}

@if (Model.StatusMessage is not null)
{
    <div class="notice notice-info">@Model.StatusMessage</div>
}

@if (Model.MySaved.Count > 0)
{
    <div class="card" style="margin-bottom:1.25rem">
        <h3>My saved queries</h3>
        <div class="table-wrap" style="margin-top:.75rem">
            <table class="data">
                <thead>
                    <tr><th>Name</th><th>Description</th><th class="num">Runs</th><th>Last run</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.MySaved)
                    {
                        <tr>
                            <td><a href="/Query/Sql?savedId=@r.Id">@r.Name</a></td>
                            <td>@r.Description</td>
                            <td class="num">@r.RunCount</td>
                            <td class="nowrap">@(r.LastRunUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id"
                                      style="display:inline"
                                      onsubmit="return confirm('Delete the saved query '@r.Name'?');">
                                    <button type="submit" class="linklike">delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small muted" style="margin-top:.75rem;margin-bottom:0">
            Loading a saved query puts it in the editor; it is screened again before it runs,
            so a query saved before a schema change fails safely rather than silently.
        </p>
    </div>
}

<form method="post" class="card">
    <div class="field">
        <label asp-for="Sql">Query</label>
        <textarea asp-for="Sql" class="sql" spellcheck="false"
                  placeholder="SELECT TOP (100) * FROM dbo.PiholeQueries ORDER BY ts DESC"></textarea>
        <span class="help">
            One statement, beginning with <code>SELECT</code> or <code>WITH</code>.
            Add <code>TOP (n)</code> to keep large scans cheap.
        </span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(!Model.Enabled)">Run query</button>
        <button type="submit" class="btn btn-secondary" asp-page-handler="Export"
                disabled="@(!Model.Enabled)">Export CSV</button>
        <span class="spacer"></span>
        <a class="btn btn-ghost" href="/Query/Builder">Use the builder instead</a>
    </div>

    <details class="save-panel" @(Model.SavedId is not null ? "open" : "")>
        <summary>Save this query</summary>
        <div class="field-row" style="margin-top:.75rem">
            <div class="field">
                <label asp-for="SaveInput.Name">Name</label>
                <input asp-for="SaveInput.Name" type="text" maxlength="128"
                       placeholder="e.g. Busiest clients, last 24h" />
            </div>
            <div class="field field-wide">
                <label asp-for="SaveInput.Description">Description</label>
                <input asp-for="SaveInput.Description" type="text" maxlength="512"
                       placeholder="optional" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" asp-page-handler="Save">Save query</button>
            <span class="help">
                Saved against your own account only. Saving under an existing name replaces it.
            </span>
        </div>
    </details>
</form>

@if (Model.ErrorMessage is not null)
{
    <div class="notice @(Model.Rejected ? "notice-warn" : "notice-error")" style="margin-top:1.5rem">
        <strong>@(Model.Rejected ? "Query rejected." : "Query failed.")</strong>
        @Model.ErrorMessage
    </div>
}

@if (Model.Result is not null)
{
    <partial name="Shared/_ResultTable" model="Model.Result" />
}


<partial name="Shared/_AiPanel" model="Model.AiPanel" />

<div class="card" style="margin-top:2rem">
    <h3>Schema reference</h3>
    <p style="margin-bottom:.75rem">
        The fact table is <code>dbo.PiholeQueries</code>, one row per DNS query, keyed on
        Pi&#8209;hole FTL&#8217;s own <code>id</code>.
    </p>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Object</th><th>Key columns</th><th>Notes</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>dbo.PiholeQueries</code></td>
                    <td class="mono">id, ts, type, status, status_text, domain, client, forward, reply_type, reply_time, dnssec, ede</td>
                    <td><code>ts</code> is UTC. <code>reply_time</code> is seconds.</td>
                </tr>
                <tr>
                    <td><code>dbo.DimClient</code></td>
                    <td class="mono">ip, name, mac, mac_vendor, interface, num_queries, last_query</td>
                    <td>Join on <code>DimClient.ip = PiholeQueries.client</code>. The device name column is <code>name</code>, and the OUI lookup is <code>mac_vendor</code>.</td>
                </tr>
                <tr>
                    <td><code>dbo.DimType</code></td>
                    <td class="mono">type, type_text</td>
                    <td>Decodes FTL&#8217;s <em>OTHER</em> as 100 + qtype.</td>
                </tr>
                <tr>
                    <td><code>dbo.DimStatus</code></td>
                    <td class="mono">status, status_text</td>
                    <td>Join on <code>DimStatus.status = PiholeQueries.status</code>.</td>
                </tr>
                <tr>
                    <td><code>dbo.GravityDomains</code></td>
                    <td class="mono">domain, adlist_id</td>
                    <td>Blocklist membership bridge, indexed on <code>domain</code>.</td>
                </tr>
                <tr>
                    <td><code>dbo.Adlists</code></td>
                    <td class="mono">id, address, enabled, comment, number, status, type, date_updated</td>
                    <td>Join on <code>Adlists.id = GravityDomains.adlist_id</code>.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
