@page "/Reports"
@model PiholeReportServer.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-head">
    <span class="eyebrow">Pre&#8209;canned</span>
    <h1>Reports</h1>
    <p class="lede">
        Ready-made queries over the warehouse. Each one opens with a sensible default
        date range that you can change before running, and every result can be exported
        to CSV.
    </p>
</div>

@if (Model.MySaved.Count > 0)
{
    <div class="category-head">
        <h2>My saved reports</h2>
        <span class="rule"></span>
        <span class="small muted">@Model.MySaved.Count saved</span>
    </div>

    <div class="card-grid">
        @foreach (var r in Model.MySaved)
        {
            var href = r.Kind == SavedReportKind.Sql
                ? $"/Query/Sql?savedId={r.Id}"
                : $"/Query/Builder?savedId={r.Id}";
            <a class="card" href="@href">
                <span class="badge @(r.Kind == SavedReportKind.Sql ? "badge-gold" : "badge-pine")"
                      style="align-self:flex-start;margin-bottom:.6rem">@r.Kind</span>
                <h3>@r.Name</h3>
                <p>@(string.IsNullOrWhiteSpace(r.Description) ? "No description." : r.Description)</p>
                <p class="small muted" style="margin-top:.75rem">
                    Run @r.RunCount time@(r.RunCount == 1 ? "" : "s")@(r.LastRunUtc is null
                        ? ""
                        : $", last {r.LastRunUtc:yyyy-MM-dd HH:mm} UTC")
                </p>
            </a>
        }
    </div>
}

@if (Model.Categories.Count == 0)
{
    <div class="notice notice-warn">
        <strong>No report definitions were loaded.</strong>
        Check that <code>Reports/reports.json</code> and its <code>.sql</code> files were
        deployed alongside the application.
    </div>
}

@foreach (var category in Model.Categories)
{
    <div class="category-head">
        <h2>@category.Key</h2>
        <span class="rule"></span>
        <span class="small muted">@category.Count() report@(category.Count() == 1 ? "" : "s")</span>
    </div>

    <div class="card-grid">
        @foreach (var report in category)
        {
            <a class="card" href="/Reports/@report.Id">
                <h3>@report.Title</h3>
                <p>@report.Summary</p>
                @if (report.Parameters.Count > 0)
                {
                    <p class="small muted" style="margin-top:.75rem">
                        Parameters: @string.Join(", ", report.Parameters.Select(p => p.Label))
                    </p>
                }
            </a>
        }
    </div>
}
