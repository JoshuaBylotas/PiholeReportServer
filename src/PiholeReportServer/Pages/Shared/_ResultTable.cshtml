@model PiholeReportServer.Models.QueryResult
@{
    var numeric = new HashSet<string>
    {
        "Int32", "Int64", "Int16", "Byte", "Decimal", "Double", "Single"
    };
}

<div class="result-meta">
    <span><strong>@Model.Rows.Count.ToString("N0")</strong> row@(Model.Rows.Count == 1 ? "" : "s")</span>
    <span>@Model.Columns.Count column@(Model.Columns.Count == 1 ? "" : "s")</span>
    <span>@Model.Elapsed.TotalMilliseconds.ToString("N0") ms</span>
    @if (Model.Truncated)
    {
        <span class="badge badge-gold">Truncated at @Model.RowCap.ToString("N0")</span>
    }
</div>

@if (Model.Truncated)
{
    <div class="notice notice-warn">
        <strong>Showing the first @Model.RowCap.ToString("N0") rows.</strong>
        The result set is larger. Narrow the date range or add a filter, or export to CSV
        to get the full result.
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="notice notice-info">No rows matched.</div>
}
else
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    @foreach (var c in Model.Columns)
                    {
                        <th class="@(numeric.Contains(c.ClrType) ? "num" : "")" scope="col">@c.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @for (var i = 0; i < row.Length; i++)
                        {
                            var col = Model.Columns[i];
                            var isNum = numeric.Contains(col.ClrType);
                            @if (row[i] is null)
                            {
                                <td class="null">null</td>
                            }
                            else if (row[i] is DateTime dt)
                            {
                                <td class="nowrap">@dt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            }
                            else if (isNum)
                            {
                                <td class="num">@(row[i] is long or int or short ? Convert.ToInt64(row[i]).ToString("N0") : row[i]!.ToString())</td>
                            }
                            else
                            {
                                <td>@row[i]!.ToString()</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
