@model PiholeReportServer.Models.ResultTableViewModel
@{
    var result = Model.Result;
    var numeric = new HashSet<string>
    {
        "Int32", "Int64", "Int16", "Byte", "Decimal", "Double", "Single"
    };
}

<div class="result-meta">
    <span><strong>@result.Rows.Count.ToString("N0")</strong> row@(result.Rows.Count == 1 ? "" : "s")</span>
    <span>@result.Columns.Count column@(result.Columns.Count == 1 ? "" : "s")</span>
    <span>@result.Elapsed.TotalMilliseconds.ToString("N0") ms</span>
    @if (result.Truncated)
    {
        <span class="badge badge-gold">Capped at @result.RowCap.ToString("N0")</span>
    }
</div>

@if (result.Truncated)
{
    <div class="notice notice-warn">
        <strong>The query hit the @result.RowCap.ToString("N0")-row cap.</strong>
        Totals reflect only the rows fetched. Narrow the range or add a filter for exact
        figures, or export to CSV, which has its own higher limit.
    </div>
}

@if (result.Rows.Count == 0)
{
    <div class="notice notice-info">No rows matched.</div>
}
else
{
    <div data-result-root
         data-result-token="@Model.Token"
         data-result-pagesize="@Model.PageSize"
         data-result-total="@result.Rows.Count"
         data-result-serverpaged="@(Model.ServerPaged ? "1" : "0")">

        @* Hidden until the script initialises, so with JavaScript off the first page
           still renders rather than showing controls that do nothing. *@
        <div class="result-toolbar" data-result-toolbar hidden>
            <div class="result-search">
                <label class="visually-hidden" for="resultSearch">Search results</label>
                <input type="search" id="resultSearch" data-result-search
                       placeholder="Search all columns&hellip;"
                       autocomplete="off" spellcheck="false" />
            </div>

            <span class="small muted nowrap" data-result-status></span>

            <span class="spacer"></span>

            <div class="pager">
                <button type="button" class="btn btn-secondary btn-compact"
                        data-result-prev aria-label="Previous page">&#8592;&nbsp;Prev</button>
                <button type="button" class="btn btn-secondary btn-compact"
                        data-result-next aria-label="Next page">Next&nbsp;&#8594;</button>
            </div>
        </div>

        <div class="notice notice-info" data-result-empty hidden>
            No rows match that search.
        </div>

        <div class="notice notice-warn" data-result-expired hidden>
            <strong>That result has expired.</strong> Run the query again to page through it.
        </div>

        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        @foreach (var c in result.Columns)
                        {
                            <th class="@(numeric.Contains(c.ClrType) ? "num" : "")" scope="col">@c.Name</th>
                        }
                    </tr>
                </thead>
                <tbody data-result-body>
                    @foreach (var row in Model.VisibleRows)
                    {
                        <tr>
                            @for (var i = 0; i < row.Length; i++)
                            {
                                var col = result.Columns[i];
                                var isNum = numeric.Contains(col.ClrType);
                                @if (row[i] is null)
                                {
                                    <td class="null">null</td>
                                }
                                else if (row[i] is DateTime dt)
                                {
                                    <td class="nowrap">@dt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                }
                                else if (isNum)
                                {
                                    <td class="num">@(row[i] is long or int or short ? Convert.ToInt64(row[i]).ToString("N0") : row[i]!.ToString())</td>
                                }
                                else
                                {
                                    <td>@row[i]!.ToString()</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ServerPaged)
        {
            <p class="small muted" style="margin-top:.6rem">
                Showing page 1 of @Model.PageCount.ToString("N0").
                Only @Model.PageSize rows are sent at a time; searching and paging query
                the cached result on the server, so the full
                @result.Rows.Count.ToString("N0") rows never have to reach the browser.
            </p>
        }
    </div>
}
