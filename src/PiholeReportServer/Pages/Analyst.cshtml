@page
@model PiholeReportServer.Pages.AnalystModel
@{
    ViewData["Title"] = "Analyst";
}

<div class="page-head">
    <span class="eyebrow">AI analysis</span>
    <h1>Analyst</h1>
    <p class="lede">
        Ask about your DNS traffic in plain language and keep talking &mdash; follow-ups
        like &ldquo;now just for that device&rdquo; carry the context forward. The rows it
        finds are shown in full under each answer, and so is every query it ran.
    </p>
</div>

@if (!Model.Enabled)
{
    <div class="notice notice-warn">
        <strong>The AI assistant is not configured.</strong>
        Set <code>Ai:Enabled</code> and <code>Ai:Endpoint</code>.
    </div>
}
else if (Model.UsingFallback)
{
    <div class="notice notice-warn">
        <strong>Running on the standby inference host.</strong>
        The preferred host is unreachable, so questions are being answered by
        <span class="mono">@Model.Model</span> on <span class="mono">@Model.ActiveEndpoint</span>.
        Answers are still sound but noticeably slower, and a long investigation is more
        likely to run out of time. It switches back on its own once the preferred host
        returns.
    </div>
}

@* What it thinks it knows, on the page. An assistant that silently remembers a
   wrong fact is worse than one that remembers nothing, because every later answer
   inherits the error - so this is visible and correctable, not hidden state. *@
<details class="card memory-panel" data-memory-panel @(Model.Facts.Count == 0 ? "" : "open")>
    <summary>
        <strong>What I remember</strong>
        <span class="badge badge-pine" data-memory-count>@Model.Facts.Count</span>
        <span class="small muted">&mdash; tell me things like &ldquo;the Pixel is Josh&rsquo;s phone&rdquo;</span>
    </summary>

    <ul class="memory-list" data-memory-list>
        @foreach (var f in Model.Facts)
        {
            <li>
                <span class="badge @(f.IsDevice ? "badge-pine" : "badge-gold")">@(f.IsDevice ? "device" : "note")</span>
                <span class="memory-fact">@f.Fact</span>
                @if (f.Target is not null)
                {
                    <span class="mono small muted">@f.Target</span>
                }
                <form method="post" asp-page-handler="Forget" asp-route-id="@f.Id"
                      asp-route-c="@Model.ConversationId">
                    <button type="submit" class="btn-link small" aria-label="Forget this">Forget</button>
                </form>
            </li>
        }
        @if (Model.Facts.Count == 0)
        {
            <li class="small muted" data-memory-empty>
                Nothing yet. Say &ldquo;remember that the Pixel is Josh&rsquo;s phone&rdquo; in the chat,
                or add one below.
            </li>
        }
    </ul>

    <form method="post" asp-page-handler="Remember" asp-route-c="@Model.ConversationId"
          class="memory-add">
        <input type="text" name="subject" maxlength="100" required
               placeholder="What I should call it, e.g. Jason's phone" />
        <input type="text" name="target" maxlength="255"
               placeholder="Hostname, IP or MAC (leave blank for a general note)" />
        <button type="submit" class="btn btn-secondary btn-compact">Remember</button>
    </form>
</details>

<div class="chat" data-chat data-page-size="@Model.PageSize">

    <div class="chat-transcript" data-chat-transcript>
        @if (Model.Conversation is null || Model.Conversation.Turns.Count == 0)
        {
            <div class="card chat-intro" data-chat-intro>
                <h3>Ask me about your network</h3>
                <p class="small muted">
                    I can see the whole query warehouse &mdash; devices, blocklists, and what
                    kind of content each domain hosts &mdash; so you can ask by category
                    rather than only by domain name. Try one of these:
                </p>
                <div class="chat-suggestions">
                    @foreach (var ex in PiholeReportServer.Pages.AnalystModel.Examples)
                    {
                        <button type="button" class="chip" data-chat-suggestion>@ex</button>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var turn in Model.Conversation.Turns)
            {
                <partial name="Shared/_ChatTurn" model="turn" />
            }
        }
    </div>

    <form class="chat-composer" method="post" data-chat-form
          asp-page-handler="Ask" asp-route-c="@Model.ConversationId">
        <input type="hidden" name="ConversationId" value="@Model.ConversationId" data-chat-id />
        <label class="visually-hidden" asp-for="Question">Your question</label>
        <textarea asp-for="Question" data-chat-input rows="1" maxlength="500"
                  placeholder="Ask about your DNS traffic&hellip;"
                  autocomplete="off" enterkeyhint="send"
                  disabled="@(!Model.Enabled)"></textarea>
        <button type="submit" class="btn btn-primary" data-chat-send disabled="@(!Model.Enabled)">
            <span data-chat-send-label>Ask</span>
        </button>
    </form>

    <div class="chat-foot small muted">
        <span>
            Runs on your own hardware, on <span class="mono">@Model.Model</span>. Up to
            @Model.MaxSteps queries and @Model.BudgetSeconds seconds per question.
        </span>
        @if (Model.Conversation is not null && Model.Conversation.Turns.Count > 0)
        {
            <form method="post" asp-page-handler="Clear" asp-route-c="@Model.ConversationId">
                <button type="submit" class="btn-link">Start a new conversation</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @* result-table.js is already loaded by the layout for every page. *@
    <script src="~/js/analyst-chat.js" asp-append-version="true" defer></script>
}
