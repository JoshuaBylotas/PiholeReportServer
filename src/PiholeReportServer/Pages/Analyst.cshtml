@page
@model PiholeReportServer.Pages.AnalystModel
@{
    ViewData["Title"] = "Analyst";
}

<div class="page-head">
    <span class="eyebrow">AI analysis</span>
    <h1>Analyst</h1>
    <p class="lede">
        Ask a question and the model investigates it &mdash; writing a query, reading the
        result, and following up if it needs more, up to @Model.MaxSteps queries. Every
        query it runs is shown, so you can check the reasoning rather than take the
        conclusion on trust.
    </p>
</div>

@if (!Model.Enabled)
{
    <div class="notice notice-warn">
        <strong>The AI assistant is not configured.</strong>
        Set <code>Ai:Enabled</code> and <code>Ai:Endpoint</code>.
    </div>
}

<form method="post" class="card">
    <div class="field">
        <label asp-for="Question">Your question</label>
        <input asp-for="Question" type="text" maxlength="500"
               placeholder="e.g. which device generates the most tracking traffic this week?"
               autocomplete="off" />
        <span class="help">
            Runs on your own hardware. Expect up to @Model.BudgetSeconds seconds &mdash;
            each step is a generation plus a database query, and <span class="mono">@Model.Model</span>
            runs on CPU.
        </span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(!Model.Enabled)">Investigate</button>
    </div>

    <div asp-validation-summary="All" class="notice notice-error" style="margin-top:1rem"></div>
</form>

@if (Model.Run is null)
{
    <div class="card" style="margin-top:1.5rem">
        <h3>Things worth asking</h3>
        <ul class="example-list">
            @foreach (var ex in PiholeReportServer.Pages.AnalystModel.Examples)
            {
                <li>@ex</li>
            }
        </ul>
        <p class="small muted" style="margin-bottom:0">
            The model knows the warehouse schema, including the domain categories, so it
            can answer by content type rather than only by domain name.
        </p>
    </div>
}
else
{
    var run = Model.Run;

    <div class="result-meta" style="margin-top:1.5rem">
        <span><strong>@run.SuccessfulQueries</strong> quer@(run.SuccessfulQueries == 1 ? "y" : "ies") run</span>
        <span>@run.Elapsed.TotalSeconds.ToString("N0")s</span>
        <span class="mono">@run.Model</span>
        @switch (run.Outcome)
        {
            case AgentOutcome.Answered:
                <span class="badge badge-pine">Answered</span>
                break;
            case AgentOutcome.StepLimit:
                <span class="badge badge-gold">Ran out of queries</span>
                break;
            case AgentOutcome.Timeout:
                <span class="badge badge-gold">Ran out of time</span>
                break;
            default:
                <span class="badge badge-gold">Failed</span>
                break;
        }
    </div>

    @if (run.HasAnswer)
    {
        <div class="card ai-panel">
            <div class="ai-head">
                <span class="icon-tile ai-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3v3" /><path d="M12 18v3" /><path d="M3 12h3" /><path d="M18 12h3" />
                        <circle cx="12" cy="12" r="4" />
                    </svg>
                </span>
                <div>
                    <h3 style="margin:0">Conclusion</h3>
                    <p class="small muted" style="margin:0">Check it against the queries below.</p>
                </div>
            </div>
            <div class="ai-answer">
                <div class="ai-prose">@run.Answer</div>
            </div>
        </div>
    }

    @if (run.Error is not null)
    {
        <div class="notice notice-error">
            <strong>The investigation did not complete.</strong> @run.Error
        </div>
    }

    @if (run.Steps.Count > 0)
    {
        <div class="category-head">
            <h2>What it did</h2>
            <span class="rule"></span>
            <span class="small muted">@run.Steps.Count step@(run.Steps.Count == 1 ? "" : "s")</span>
        </div>

        @foreach (var step in run.Steps)
        {
            <div class="card agent-step">
                <div class="row">
                    <span class="step-number">@step.Number</span>
                    @switch (step.Kind)
                    {
                        case AgentStepKind.Query:
                            <span class="badge badge-pine">
                                @step.RowCount.ToString("N0") row@(step.RowCount == 1 ? "" : "s")
                            </span>
                            break;
                        case AgentStepKind.Refused:
                            <span class="badge badge-gold">Refused by the guard</span>
                            break;
                        default:
                            <span class="badge badge-gold">Query failed</span>
                            break;
                    }
                    @if (step.Truncated)
                    {
                        <span class="badge badge-gold">Capped</span>
                    }
                    <span class="spacer"></span>
                    @if (step.Elapsed > TimeSpan.Zero)
                    {
                        <span class="small muted">@step.Elapsed.TotalMilliseconds.ToString("N0") ms</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(step.Reasoning))
                {
                    <p class="small muted" style="margin:.6rem 0 0">@step.Reasoning</p>
                }

                <pre class="ai-sql">@step.Sql</pre>

                @if (step.Problem is not null)
                {
                    <div class="notice notice-warn" style="margin-bottom:0">@step.Problem</div>
                }

                @if (step.Result is not null && step.Result.Rows.Count > 0)
                {
                    <details>
                        <summary class="small muted" style="cursor:pointer">
                            Show the rows the model saw
                        </summary>
                        <div style="margin-top:.75rem">
                            <partial name="Shared/_ResultTable" model="ResultTableViewModel.Inline(step.Result)" />
                        </div>
                    </details>
                }
            </div>
        }
    }
}
